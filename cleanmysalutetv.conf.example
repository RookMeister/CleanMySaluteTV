# Настройки CleanMySaluteTV. Скопируй в cleanmysalutetv.conf, поправь и запусти:  bash scripts/install.sh
# После любых правок:  bash scripts/install.sh --config-only   (без пересборки и переустановки)

# --- подключение --------------------------------------------------------------------------------
TV_IP=192.168.1.50                 # bash scripts/find_tv.sh покажет ТВ в сети

# --- главный экран ------------------------------------------------------------------------------
# Док: пакеты приложений слева направо через запятую. Остальное — в сетке ниже.
# Список установленных:  adb shell pm list packages -3
DOCK="ru.kinopoisk.tv,ru.rt.video.app.tv,com.vk.tv,ru.rutube.app"

GREETING_NAME=""                   # имя в приветствии: «Добрый вечер, Саша»
COLUMNS_PER_ROW=5                  # плиток в ряду, 4–7
HIDDEN_APPS=""                     # спрятать ещё приложения (через запятую); приложения Sber,
                                   # которые возвращаются после перезагрузки, прячутся всегда
APP_LABELS=""                      # свои подписи: "ru.ivi.client=Иви,com.vk.tv=ВК"
LIVE_TV_PACKAGE=""                 # приложение «Live TV» в меню входов; пусто — без него
APP_LIBRARY=yes                    # кнопка «Все приложения»: добавлять и убирать плитки прямо с ТВ
SHOW_STATS=no                      # строка под часами: процессор, память, место
REDUCED_MOTION=no                  # меньше анимации для слабого процессора

# Сцены: картинка с большими стеклянными часами, горы и холмы заходят на цифры (как в couch-tv).
# Пока сцены включены, обои ниже не показываются, а маленькие часы в шапке скрыты.
SCENES=yes
SCENE_SECONDS=20                   # смена сцены, 10–3600 секунд
SCENE_LIST=""                      # порядок и выбор: "night,golden,water,fog,dawn"; пусто — все пять

# Погода под датой: город, значок, температура, небо. Open-Meteo, бесплатно и без ключа; обновляется
# раз в 30 минут и только пока открыт главный экран. Координаты города: https://www.latlong.net
WEATHER=yes
WEATHER_CITY="Москва"              # подпись перед температурой; пусто — без подписи
WEATHER_LAT=55.7558
WEATHER_LON=37.6173

# Обои (только при SCENES=no): путь к своему JPEG (лучше 1920×1080 и тёмный) или пусто — чёрный фон.
WALLPAPER=""

# Любые другие ключи лаунчера — в config.extra.json рядом с этим файлом (см. docs/CONFIG.md).

# --- заставка -----------------------------------------------------------------------------------
#   clock     часы CleanMySaluteTV, плавно сдвигаются (не выжигают экран)
#   original  вернуть заставку Sber
#   off       без заставки
SCREENSAVER=clock

# --- система ------------------------------------------------------------------------------------
# На Салют ТВ (платы CVTE) штатный лаунчер обычно можно оставить включённым: хватает set-home-activity.
# Если кнопка Home всё равно открывает Салют ТВ, поставь yes (вернуть: bash scripts/restore.sh).
DISABLE_STOCK_LAUNCHER=no
AD_BLOCK_DNS=no                    # yes = частный DNS AdGuard: режет рекламные и трекинговые домены
AD_BLOCK_DNS_HOST=dns.adguard-dns.com
