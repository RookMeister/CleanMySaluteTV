<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- CleanMySaluteTV: only for the weather line (WeatherClient), which asks Open-Meteo for the configured
         coordinates every 30 minutes while Home is on screen. Nothing else in the launcher uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- CleanMySaluteTV: the Memory top button (MemoryClean) closes other apps' background processes; a normal
         permission, granted at install. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- CleanMySaluteTV AirPlay guard (AirPlayGuard, after Hume Launcher): an mDNS query to see the AirPlay receiver
         is still announced. DUMP is what AirPlay Server's settings receiver asks of callers; Android never grants
         it at install, only install.sh with AIRPLAY=yes does (pm grant), and without it the guard only starts a
         stopped receiver. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- CleanMySaluteTV sleep timer (PowerControl): on time rather than in Android's loose window. Not granted at
         install from Android 13; install.sh allows it with POWER=yes (appops). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed since Android 10 to read the Wi-Fi network name for the network pill. Never requested at
         runtime: build-and-install grants it with pm grant, so lint's Android 12 "ask for COARSE with
         FINE" rule does not apply here. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />
    <!-- Puts the remote's accessibility helpers back after a force stop of this app took them off the enabled
         list (ServiceRepair). Granted with pm grant by build-and-install when a helper is enabled. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles, and the
         apps that declare a module card (docs/specs/card.md). -->
    <queries>
        <!-- The standard settings handlers, so package visibility doesn't hide them and send the pills to a vendor fallback by mistake. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <!-- The tile menu and the app library offer App info only where this resolves (SystemSettings.appInfo). -->
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.rookmeister.cleanmysalutetv.category.DOCK_CARD" />
        </intent>
        <!-- The AirPlay receiver the AirPlay guard looks after (AirPlayGuard). -->
        <package android:name="io.github.jqssun.airplay" />
        <!-- stock_home_redirect: HomeKeyService looks up the stock launcher's HOME activity. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <!-- CVTE firmware (ro.CVT_EN_COMMON_HOME_INTENT=1) sends the Home key and boot as MAIN + HOME +
                 COMMON_HOME, which only matches a filter that lists both (#1201). In this one filter, not a second
                 one: a plain HOME intent still matches it, and a second filter could list this activity twice. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.COMMON_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the TV's own app list, so it can be opened from the stock home screen too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CleanMySaluteTV's settings menu, after couch-tv's Home settings; Launcher settings is one row inside it. -->
        <activity
            android:name=".MenuSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvHome" />
        <activity
            android:name=".LauncherSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />
        <!-- The system input switcher (com.android.tv.action.VIEW_INPUTS), which is what the remote's Input
             button becomes through the TV's Live TV app or InputKeyService. Disabled here and switched on by
             MainActivity only while handle_view_inputs is true (config.xml or a theme), for sets whose stock
             launcher was the only handler of the action (Hisense huangshan, Android TV 10): kept off, a TV with
             its own input picker never sees a second candidate and a chooser. -->
        <activity
            android:name=".InputsRequestActivity"
            android:exported="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.android.tv.action.VIEW_INPUTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TvHome" />
        <!-- Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in: HOME_KEY_SERVICE=1
             build-and-install.sh; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- market://launch?id=<package>: package-name app launches from the Android TV Remote service
             (Home Assistant android_tv_remote), normally served by the stock launcher. -->
        <activity
            android:name=".AppLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="market" android:host="launch" />
            </intent-filter>
        </activity>

        <!-- The same clock, started by Home itself after home_idle_clock_minutes without input. -->
        <activity
            android:name=".ClockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- stock_home_redirect at boot: HomeKeyService opens this invisible activity once, so the screen behind
             it sends a window event when it closes (HomeKeyService.probeAtBoot). -->
        <activity
            android:name=".ProbeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.rookmeister.cleanmysalutetv/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- tools/theme.sh writes the theme through this where the shell can't reach Android/data;
             see ThemeProvider. WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't. -->
        <provider
            android:name=".ThemeProvider"
            android:authorities="${applicationId}.theme"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- The remote's Input button (KEYCODE_TV or KEYCODE_TV_INPUT) opens the input switcher, and input_key_keycodes and
         app_keys (config.xml or a theme) bring back other remote buttons; see InputKeyService. -->
        <!-- Bound again by the system after a force stop, which restarts Home on firmware that kills
             third-party apps (TCL tc8000_ay30a2). It reads no notification.
             cmd notification allow_listener com.rookmeister.cleanmysalutetv/.GuardRevival -->
        <service
            android:name=".GuardRevival"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/home_key_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".GuardConfig"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.rookmeister.cleanmysalutetv.GUARD" />
            </intent-filter>
        </receiver>

        <!-- CleanMySaluteTV PowerControl: device admin with only the force-lock policy (screen off, sleep timer),
             and the sleep timer's alarm. -->
        <receiver
            android:name=".PowerControl$Admin"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".PowerControl$TimerReceiver"
            android:exported="false" />
        <!-- restore.sh and install.sh (POWER=no): give up the device admin role. The adb shell holds this permission,
             ordinary apps cannot get it. -->
        <receiver
            android:name=".PowerControl$Release"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <service
            android:name=".InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>
    </application>
</manifest>
