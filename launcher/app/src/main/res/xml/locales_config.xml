<?xml version="1.0" encoding="utf-8"?>
<!-- Languages the launcher is translated into: CleanMySaluteTV keeps Russian and English only. Lets Android 13+
     give the launcher its own language ("cmd locale set-app-locales"). -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
</locale-config>
