<?xml version="1.0" encoding="utf-8"?>
<!-- couch-tv's quick buttons: dark rose-tinted glass with a thin light edge; white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- A running sleep timer. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#80140C12" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#521E141C" />
            <stroke android:width="1dp" android:color="#29FFD2DC" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
